<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(function(){
  "use strict";

  /* ---------- toast ---------- */
  var toastEl = document.getElementById('toast'), toastTimer;
  function toast(msg, kind){
    toastEl.textContent = msg;
    toastEl.dataset.kind = kind || 'ok';
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ toastEl.classList.remove('show'); }, 3600);
  }

  /* ---------- mobile nav ---------- */
  var burger = document.querySelector('.burger'), mnav = document.getElementById('mobileNav');
  burger.addEventListener('click', function(){
    var open = mnav.classList.toggle('open');
    burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
  });
  mnav.addEventListener('click', function(e){
    if(e.target.tagName === 'A'){ mnav.classList.remove('open'); burger.setAttribute('aria-expanded','false'); }
  });

  /* ---------- reveal on scroll ---------- */
  var revealIO = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if(en.isIntersecting){ en.target.classList.add('in'); revealIO.unobserve(en.target); }
    });
  }, {threshold:.14});
  document.querySelectorAll('.reveal').forEach(function(el){ revealIO.observe(el); });

  /* ---------- goal: countup + progress ---------- */
  var raisedEl = document.getElementById('raisedNum');
  var fillEl = document.getElementById('progressFill');
  fillEl.style.width = '0%';
  var fmt = function(n){ return n.toLocaleString('ru-RU'); };
  var counted = false;
  function runGoal(){
    if(counted) return; counted = true;
    var target = 680000, dur = 1400, start = performance.now();
    fillEl.style.width = '68%';
    (function step(t){
      var p = Math.min(1, (t - start) / dur);
      var e = 1 - Math.pow(1 - p, 3);
      raisedEl.textContent = fmt(Math.round(target * e)) + ' ₽';
      if(p < 1) requestAnimationFrame(step);
    })(start);
  }
  var goalIO = new IntersectionObserver(function(entries){
    entries.forEach(function(en){ if(en.isIntersecting){ runGoal(); goalIO.disconnect(); } });
  }, {threshold:.35});
  goalIO.observe(document.getElementById('goal'));

  document.getElementById('donateBtn').addEventListener('click', function(){
    toast('Спасибо за поддержку! Демо-версия: оплата не подключена.', 'ok');
  });

  /* ---------- seat map ---------- */
  var ROWS = ['А','Б','В','Г','Д','Е','Ж','З'];
  var COLS = 12, PRICE = 600, MAX = 6;
  function mulberry32(a){
    return function(){
      a |= 0; a = a + 0x6D2B79F5 | 0;
      var t = Math.imul(a ^ a >>> 15, 1 | a);
      t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
      return ((t ^ t >>> 14) >>> 0) / 4294967296;
    };
  }
  var rnd = mulberry32(20251204);
  var taken = {}, rowTaken = {};
  for(var r = 0; r < ROWS.length; r++) rowTaken[r] = 0;
  for(r = 0; r < ROWS.length; r++){
    for(var c = 0; c < COLS; c++){
      if(taken[r + '-' + c]) continue;
      if(rowTaken[r] >= 6) continue;
      if(rnd() < 0.26){
        taken[r + '-' + c] = true; rowTaken[r]++;
        if(c < COLS - 1 && rowTaken[r] < 6 && rnd() < 0.5){
          taken[r + '-' + (c + 1)] = true; rowTaken[r]++; c++;
        }
      }
    }
  }
  var selected = {};
  var selectedCount = 0;
  var grid = document.getElementById('seatGrid');
  var summary = document.getElementById('seatSummary');
  var payBtn = document.getElementById('payBtn');

  function plural(n, one, few, many){
    var m10 = n % 10, m100 = n % 100;
    if(m10 === 1 && m100 !== 11) return one;
    if(m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
    return many;
  }
  function seatLabel(r, c, state){
    return 'Ряд ' + ROWS[r] + ', место ' + (c + 1) + ' — ' + state;
  }
  function updateSummary(){
    if(selectedCount === 0){
      summary.textContent = 'Места не выбраны — выберите до 6 мест на схеме';
      payBtn.disabled = true;
    } else {
      summary.innerHTML = 'Выбрано <b>' + selectedCount + ' ' + plural(selectedCount,'место','места','мест') +
        '</b> · к оплате <b>' + fmt(selectedCount * PRICE) + ' ₽</b>';
      payBtn.disabled = false;
    }
  }

  ROWS.forEach(function(letter, r){
    var l1 = document.createElement('span');
    l1.className = 'row-letter'; l1.textContent = letter; l1.setAttribute('aria-hidden','true');
    grid.appendChild(l1);
    for(var c = 0; c < COLS; c++){
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'seat';
      b.dataset.r = r; b.dataset.c = c;
      if(taken[r + '-' + c]){
        b.classList.add('taken');
        b.disabled = true;
        b.tabIndex = -1;
        b.setAttribute('aria-label', seatLabel(r, c, 'занято'));
        b.setAttribute('aria-disabled','true');
      } else {
        b.textContent = c + 1;
        b.setAttribute('aria-pressed','false');
        b.setAttribute('aria-label', seatLabel(r, c, 'свободно'));
      }
      grid.appendChild(b);
    }
    var l2 = document.createElement('span');
    l2.className = 'row-letter'; l2.textContent = letter; l2.setAttribute('aria-hidden','true');
    grid.appendChild(l2);
  });

  grid.addEventListener('click', function(e){
    var s = e.target.closest('.seat');
    if(!s || s.disabled) return;
    var r = +s.dataset.r, c = +s.dataset.c, id = r + '-' + c;
    if(selected[id]){
      delete selected[id]; selectedCount--;
      s.classList.remove('sel');
      s.setAttribute('aria-pressed','false');
      s.setAttribute('aria-label', seatLabel(r, c, 'свободно'));
    } else {
      if(selectedCount >= MAX){
        toast('Можно выбрать не более ' + MAX + ' мест за один заказ', 'warn');
        return;
      }
      selected[id] = true; selectedCount++;
      s.classList.add('sel');
      s.setAttribute('aria-pressed','true');
      s.setAttribute('aria-label', seatLabel(r, c, 'выбрано'));
    }
    updateSummary();
  });

  document.getElementById('resetSeats').addEventListener('click', function(){
    if(selectedCount === 0) return;
    grid.querySelectorAll('.seat.sel').forEach(function(s){
      s.classList.remove('sel');
      s.setAttribute('aria-pressed','false');
      s.setAttribute('aria-label', seatLabel(+s.dataset.r, +s.dataset.c, 'свободно'));
    });
    selected = {}; selectedCount = 0;
    updateSummary();
  });

  payBtn.addEventListener('click', function(){
    if(selectedCount === 0) return;
    toast('Забронировано ' + selectedCount + ' ' + plural(selectedCount,'место','места','мест') +
      ' на ' + fmt(selectedCount * PRICE) + ' ₽. Демо-версия: оплата не подключена.', 'ok');
  });

  updateSummary();
})();
</script>
</body>
</html>
```